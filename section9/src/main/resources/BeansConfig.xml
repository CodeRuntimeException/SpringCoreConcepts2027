<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="vehicle" class="com.s2p.beans.Vehicle">
        <property name="name" value="HondaCivic"></property>
    </bean>

    <bean id="person" class="com.s2p.beans.Person">
        <property name="firstName" value="Pranay"></property>
        <property name="lastName" value="Ramteke"></property>
        <property name="personId" value="1212"></property>
        <property name="rich" value="true"></property>
    </bean>



</beans>